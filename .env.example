# Copie para .env e preencha. NUNCA versione o .env.
#   cp .env.example .env && chmod 600 .env

# Credenciais da sua conta, obtidas em https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Token do bot criado no @BotFather
BOT_TOKEN=

# Seu user_id numérico do Telegram (o bot só responde a ele). Descubra com @userinfobot.
OWNER_USER_ID=

# Token exigido em todas as rotas /api (header X-API-Token). Mínimo 32 caracteres.
# Gere com: tgmonitor gen-token
API_TOKEN=

# Diretório de dados (sessão Telethon + banco SQLite). Fora do repositório.
# Padrão: ~/.local/share/telegram-monitor  | Na VM: /var/lib/telegram-monitor
# DATA_DIR=/var/lib/telegram-monitor

# Porta da interface web (sempre escuta só em 127.0.0.1)
# WEB_PORT=8000

# Opcional: URL de heartbeat (ex: healthchecks.io). Recebe um GET a cada 5 min
# enquanto o listener está saudável. Nenhum dado é enviado.
# HEALTHCHECK_URL=https://hc-ping.com/seu-uuid

# Nível de log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
